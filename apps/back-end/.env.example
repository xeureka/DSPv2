# Runtime
NODE_ENV=development
PORT=3001
HOST=0.0.0.0
LOG_LEVEL=info

# PostgreSQL / Neon
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
TEST_DATABASE_URL=
TEST_AUTH_EMAIL=
TEST_AUTH_PASSWORD=

# Better Auth
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3001
WEB_APP_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# Development-only seed credentials; never commit real values.
SEED_MANAGER_EMAIL=
SEED_MANAGER_NAME=
SEED_MANAGER_PASSWORD=
SEED_DISPATCHER_EMAIL=
SEED_DISPATCHER_NAME=
SEED_DISPATCHER_PASSWORD=
SEED_TECHNICIAN_EMAIL=
SEED_TECHNICIAN_NAME=
SEED_TECHNICIAN_PASSWORD=

# Planned DispatchPilot integrations (not used by this foundation yet).
GEMINI_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DRY_RUN=true
SCHEDULER_SECRET=
