{
	"compilerOptions": {
		"target": "ES2023",
		"lib": ["ES2023"],
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"rootDir": "src",
		"composite": true,
		"declaration": true,
		"emitDeclarationOnly": true,
		"outDir": "dist",
		"strict": true,
		"skipLibCheck": true,
		"verbatimModuleSyntax": true
	},
	"include": ["src"]
}
